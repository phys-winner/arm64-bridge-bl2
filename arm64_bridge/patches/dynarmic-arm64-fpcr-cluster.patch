+static bool NativeStandardFPVectorMath(const IR::Inst& inst) {
+    size_t control_arg;
+    switch (inst.GetOpcode()) {
+    case IR::Opcode::FPVectorAdd32:
+    case IR::Opcode::FPVectorAdd64:
+    case IR::Opcode::FPVectorSub32:
+    case IR::Opcode::FPVectorSub64:
+    case IR::Opcode::FPVectorMul32:
+    case IR::Opcode::FPVectorMul64:
+        control_arg = 2;
+        break;
+    case IR::Opcode::FPVectorMulAdd32:
+    case IR::Opcode::FPVectorMulAdd64:
+        control_arg = 3;
+        break;
+    default:
+        return false;
+    }
+    return inst.GetArg(control_arg).IsImmediate() && !inst.GetArg(control_arg).GetU1();
+}
+
+// IR nodes that neither depend on FPCR nor call out of the block (register
+// file moves, integer and bitwise operations): a standard-mode run of native
+// math may span them. A32 NEON math always has Get/SetVector between.
+static bool FPCRNeutral(const IR::Inst& inst) {
+    switch (inst.GetOpcode()) {
+    case IR::Opcode::A32GetRegister:
+    case IR::Opcode::A32SetRegister:
+    case IR::Opcode::A32GetExtendedRegister32:
+    case IR::Opcode::A32GetExtendedRegister64:
+    case IR::Opcode::A32SetExtendedRegister32:
+    case IR::Opcode::A32SetExtendedRegister64:
+    case IR::Opcode::A32GetVector:
+    case IR::Opcode::A32SetVector:
+    case IR::Opcode::VectorGetElement32:
+    case IR::Opcode::VectorGetElement64:
+    case IR::Opcode::VectorSetElement32:
+    case IR::Opcode::VectorSetElement64:
+    case IR::Opcode::VectorBroadcast32:
+    case IR::Opcode::VectorBroadcast64:
+    case IR::Opcode::VectorBroadcastElement32:
+    case IR::Opcode::VectorBroadcastElement64:
+    case IR::Opcode::VectorAnd:
+    case IR::Opcode::VectorOr:
+    case IR::Opcode::VectorEor:
+    case IR::Opcode::VectorNot:
+    case IR::Opcode::VectorAndNot:
+    case IR::Opcode::VectorZeroUpper:
+    case IR::Opcode::ZeroVector:
+    case IR::Opcode::Add32:
+    case IR::Opcode::Sub32:
+    case IR::Opcode::And32:
+    case IR::Opcode::Or32:
+    case IR::Opcode::Eor32:
+    case IR::Opcode::LeastSignificantWord:
+    case IR::Opcode::MostSignificantWord:
+    case IR::Opcode::Pack2x32To1x64:
+        return true;
+    default:
+        return false;
+    }
+}
+
+// Whether another native math node is reachable from `it` (exclusive) across
+// FPCR-neutral nodes only; both directions use the same rule and bound, so the
+// operations at the two ends of a run agree on who switches the mode.
+template<typename Step>
+static bool StandardMathReachable(const IR::Block& block, IR::Block::const_iterator it, Step step) {
+    for (unsigned budget = 64; budget; --budget) {
+        if (!step(block, it)) return false;
+        if (NativeStandardFPVectorMath(*it)) return true;
+        if (!FPCRNeutral(*it)) return false;
+    }
+    return false;
+}
