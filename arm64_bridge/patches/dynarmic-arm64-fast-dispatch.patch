+        fast_entry.code_ptr = block_entry;
+        fast_entry.descriptor = descriptor.Value();
         return block_entry;
     }
 
     IR::Block ir_block = GenerateIR(descriptor);
     const EmittedBlockInfo block_info = Emit(std::move(ir_block));
+    fast_entry.code_ptr = block_info.entry_point;
+    fast_entry.descriptor = descriptor.Value();
     return block_info.entry_point;
 }
 
+void AddressSpace::ClearFastDispatchTable() {
+    for (FastDispatchEntry& entry : fast_dispatch_table) {
+        entry.code_ptr = nullptr;
+    }
