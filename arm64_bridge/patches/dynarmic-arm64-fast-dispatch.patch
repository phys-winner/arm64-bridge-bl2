diff --git a/src/dynarmic/backend/arm64/emit_arm64_a32.cpp b/src/dynarmic/backend/arm64/emit_arm64_a32.cpp
index 909dde73..bd5847f1 100644
--- a/src/dynarmic/backend/arm64/emit_arm64_a32.cpp
+++ b/src/dynarmic/backend/arm64/emit_arm64_a32.cpp
@@ -24,10 +24,73 @@ using namespace oaknut::util;
 
 oaknut::Label EmitA32Cond(oaknut::CodeGenerator& code, EmitContext&, IR::Cond cond) {
     oaknut::Label pass;
-    // TODO: Flags in host flags
     code.LDR(Wscratch0, Xstate, offsetof(A32JitState, cpsr_nzcv));
-    code.MSR(oaknut::SystemReg::NZCV, Xscratch0);
-    code.B(static_cast<oaknut::Cond>(cond), pass);
+
+    // A32JitState stores N, Z, C and V in their architectural bits 31..28.
+    // Test those bits directly instead of restoring NZCV with MSR before
+    // every conditional block. Besides being cheaper, this leaves host flags
+    // available to the first emitted guest operation.
+    switch (cond) {
+    case IR::Cond::EQ:
+        code.TBNZ(Wscratch0, 30, pass);
+        break;
+    case IR::Cond::NE:
+        code.TBZ(Wscratch0, 30, pass);
+        break;
+    case IR::Cond::CS:
+        code.TBNZ(Wscratch0, 29, pass);
+        break;
+    case IR::Cond::CC:
+        code.TBZ(Wscratch0, 29, pass);
+        break;
+    case IR::Cond::MI:
+        code.TBNZ(Wscratch0, 31, pass);
+        break;
+    case IR::Cond::PL:
+        code.TBZ(Wscratch0, 31, pass);
+        break;
+    case IR::Cond::VS:
+        code.TBNZ(Wscratch0, 28, pass);
+        break;
+    case IR::Cond::VC:
+        code.TBZ(Wscratch0, 28, pass);
+        break;
+    case IR::Cond::HI: {  // C && !Z
+        oaknut::Label fail;
+        code.TBZ(Wscratch0, 29, fail);
+        code.TBZ(Wscratch0, 30, pass);
+        code.l(fail);
+        break;
+    }
+    case IR::Cond::LS:  // !C || Z
+        code.TBZ(Wscratch0, 29, pass);
+        code.TBNZ(Wscratch0, 30, pass);
+        break;
+    case IR::Cond::GE:  // N == V
+        code.EOR(Wscratch0, Wscratch0, Wscratch0, LSL, 3);
+        code.TBZ(Wscratch0, 31, pass);
+        break;
+    case IR::Cond::LT:  // N != V
+        code.EOR(Wscratch0, Wscratch0, Wscratch0, LSL, 3);
+        code.TBNZ(Wscratch0, 31, pass);
+        break;
+    case IR::Cond::GT: {  // !Z && N == V
+        oaknut::Label fail;
+        code.TBNZ(Wscratch0, 30, fail);
+        code.EOR(Wscratch0, Wscratch0, Wscratch0, LSL, 3);
+        code.TBZ(Wscratch0, 31, pass);
+        code.l(fail);
+        break;
+    }
+    case IR::Cond::LE:  // Z || N != V
+        code.TBNZ(Wscratch0, 30, pass);
+        code.EOR(Wscratch0, Wscratch0, Wscratch0, LSL, 3);
+        code.TBNZ(Wscratch0, 31, pass);
+        break;
+    default:
+        ASSERT_MSG(false, "Unknown cond {}", static_cast<size_t>(cond));
+        break;
+    }
     return pass;
 }
 
