+    FastDispatchEntry& fast_entry = fast_dispatch_table[FastDispatchIndex(descriptor)];
+    if (fast_entry.code_ptr && fast_entry.descriptor == descriptor.Value()) {
+        return fast_entry.code_ptr;
+    }
+
