 protected:
+    struct alignas(16) FastDispatchEntry {
+        u64 descriptor = 0;
+        CodePtr code_ptr = nullptr;
+    };
+
+    static constexpr size_t fast_dispatch_table_size = 16 * 1024;
+    static constexpr u64 fast_dispatch_table_mask = fast_dispatch_table_size - 1;
+    static_assert((fast_dispatch_table_size & fast_dispatch_table_mask) == 0);
+    static_assert(sizeof(FastDispatchEntry) == 16);
+
+    static size_t FastDispatchIndex(IR::LocationDescriptor descriptor) {
+        const u64 value = descriptor.Value();
+        return static_cast<size_t>(((value >> 1) ^ (value >> 32)) & fast_dispatch_table_mask);
+    }
+
