+// Publish only after the data store completed. Fallback callbacks own their
+// successful-write publication and still branch around this inline path.
+// Xscratch0/1 and the optional reserved Xpagetable are the only registers used.
+// All instructions preserve NZCV/FPSR. Metadata is never a fastmem patch point.
+template<size_t bitsize>
+void EmitFastmemWriteWatch(oaknut::CodeGenerator& code, EmitContext& ctx, oaknut::XReg Xaddr) {
+    if (!ctx.conf.write_watch) {
+        return;
+    }
+    ASSERT(ctx.conf.page_table_pointer == 0 && ctx.conf.fastmem_address_space_bits == 32 && ctx.conf.silently_mirror_fastmem);
+    const unsigned shift = ctx.conf.write_watch_page_bits;
+    ASSERT(shift >= 4 && shift <= 31);
+    const auto Waddr = Xaddr.toW();
+    code.LSR(Wscratch0, Waddr, shift);
+    code.ADD(Xscratch1, Xpagetable, Xscratch0);
+    code.MOV(Wscratch0, 1);
+    code.STLRB(Wscratch0, Xscratch1);
+    if constexpr (bitsize > 8) {
+        oaknut::Label done;
+        // Detect a page crossing without modifying the guest's native flags.
+        code.AND(Wscratch0, Waddr, (u64{1} << shift) - 1);
+        code.ADD(Wscratch0, Wscratch0, bitsize / 8 - 1);
+        code.TBZ(Wscratch0, shift, done);
+        // Use a 64-bit last-byte address to prevent a 4GiB-end wrap into table0.
+        code.MOV(Wscratch0, Waddr);
+        code.ADD(Xscratch0, Xscratch0, bitsize / 8 - 1);
+        code.TBNZ(Xscratch0, 32, done);
+        code.LSR(Wscratch0, Wscratch0, shift);
+        code.ADD(Xscratch1, Xpagetable, Xscratch0);
+        code.MOV(Wscratch0, 1);
+        code.STLRB(Wscratch0, Xscratch1);
+        code.l(done);
+    }
+}
