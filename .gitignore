# Third-party sources fetched for the build (see README.md)
/arm64_bridge/third_party/

# Build outputs
/build/
/out/
/arm64_bridge/build*/
/touch_native_design/build/
/work/build/
/work/evidence/
/work/logs/
/work/tmp/
**/__pycache__/

# Game files never belong in this repository
/app/
/original/
*.apk
*.apks
*.xapk
*.obb
*.so
*.i64
*.idb
*.id0
*.id1
*.id2
*.nam
*.til

# Signing material
*.jks
*.keystore
*.pk8
*.pem
*.p12
*.pfx
.env

# Generated files inside the source trees.
*.a
*.o
*.obj
*.exe
*.dll
*.lib
*.pdb
*.class
*.dex
*.jar
*.zip
*.bin
*.crt
*.der

# This project versions only the ARM64 bridge, its controls and build tools.
/*
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md
!/android_port/
!/arm64_bridge/
!/touch_native_design/
!/work/

/arm64_bridge/*
!/arm64_bridge/CMakeLists.txt
!/arm64_bridge/cmake/
!/arm64_bridge/patches/
!/arm64_bridge/src/
!/arm64_bridge/tests/

/work/*
!/work/scripts/
/work/scripts/*
!/work/scripts/bl2_virtual_gamepad.py
!/work/scripts/bl2_virtual_kbm.py
!/work/scripts/bl2_virtual_mouse.py
!/work/scripts/bl2_virtual_multitouch.py
!/work/scripts/build_bridge_apk.ps1
!/work/scripts/build_launch_controls.ps1
!/work/scripts/invoke_game_button.ps1
!/work/scripts/invoke_game_stick.ps1
!/work/scripts/invoke_native_ui_gesture.ps1
!/work/scripts/verify_embedded_locale.py
